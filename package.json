{
  "name": "webcam",
  "description": "Ultimate tools for working with media stream from you webcam",
  "license": "MIT",
  "private": true,
  "author": {
    "name": "SIBERIA CAN CODE 🧊",
    "url": "https://github.com/siberiacancode"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/siberiacancode/webcam.git"
  },
  "homepage": "https://github.com/siberiacancode/webcam",
  "bugs": "https://github.com/siberiacancode/webcam/issues",
  "scripts": {
    "dev": "pnpm --filter @webcam/debug dev",
    "build": "pnpm -r --if-present run build",
    "deploy": "pnpm -r --if-present run deploy",
    "lint": "pnpm -r --if-present run lint",
    "format": "pnpm -r --if-present run format",
    "pretty": "pnpm --filter @webcam/core run pretty && pnpm --filter @webcam/react run pretty",
    "unit-test": "pnpm -r --if-present run unit-test",
    "prepare": "husky && pnpm build"
  },
  "devDependencies": {
    "@siberiacancode/prettier": "^1.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "tsdown": "^0.22.3"
  },
  "keywords": [
    "media",
    "video",
    "react",
    "canvas",
    "camera",
    "webcam",
    "stream",
    "userMedia",
    "navigator",
    "screenshot",
    "constraints",
    "getUserMedia",
    "react-webcam",
    "webcam-canvas"
  ]
}
