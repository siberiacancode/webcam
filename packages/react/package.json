{
  "name": "@webcam/react",
  "type": "module",
  "version": "1.1.1",
  "description": "Ultimate tool for working with media stream and displaying it in your React application",
  "author": {
    "name": "SIBERIA CAN CODE 🧊",
    "url": "https://github.com/siberiacancode"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/siberiacancode/webcam",
  "repository": {
    "type": "git",
    "url": "https://github.com/siberiacancode/webcam.git"
  },
  "bugs": "https://github.com/siberiacancode/webcam/issues",
  "keywords": [
    "media",
    "video",
    "react",
    "canvas",
    "camera",
    "webcam",
    "stream",
    "userMedia",
    "navigator",
    "screenshot",
    "constraints",
    "getUserMedia",
    "react-webcam",
    "webcam-canvas"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "prepublishOnly": "pnpm type && pnpm build",
    "build": "shx rm -rf dist && vite build",
    "lint": "eslint . --fix",
    "lint-inspector": "npx @eslint/config-inspector@latest",
    "type": "tsc --noEmit",
    "format": "prettier --write .",
    "pretty": "pnpm type && pnpm lint && pnpm format",
    "lint-staged": "lint-staged",
    "storybook": "storybook dev -p 6011"
  },
  "peerDependencies": {
    "@types/react": "^18.0.0",
    "react": "^17.0.2 || ^18.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "dependencies": {
    "@siberiacancode/reactuse": "1.0.4",
    "@webcam/core": "1.0.1"
  },
  "devDependencies": {
    "@siberiacancode/eslint": "^2.17.6",
    "@storybook/addon-actions": "^9.0.8",
    "@storybook/addon-links": "^10.4.6",
    "@storybook/react": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@vitejs/plugin-react": "^6.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shx": "^0.4.0",
    "storybook": "^10.4.6",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vite-plugin-dts": "^5.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
