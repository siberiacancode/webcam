{
  "name": "@webcam/core",
  "version": "1.0.1",
  "type": "module",
  "description": "Ultimate tool for working with media stream",
  "license": "MIT",
  "author": {
    "name": "SIBERIA CAN CODE 🧊",
    "url": "https://github.com/siberiacancode"
  },
  "engines": {
    "node": ">=14"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/siberiacancode/webcam.git"
  },
  "homepage": "https://github.com/siberiacancode/webcam",
  "bugs": "https://github.com/siberiacancode/webcam/issues",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.mjs",
  "types": "dist/esm/index.d.mts",
  "scripts": {
    "prepublishOnly": "pnpm type && pnpm build",
    "build": "tsdown",
    "lint": "eslint . --fix",
    "lint-inspector": "npx @eslint/config-inspector@latest",
    "type": "tsc --noEmit",
    "format": "prettier --write .",
    "pretty": "pnpm type && pnpm lint && pnpm format",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@siberiacancode/eslint": "^2.17.6",
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "media",
    "video",
    "canvas",
    "camera",
    "webcam",
    "stream",
    "userMedia",
    "navigator",
    "screenshot",
    "constraints",
    "getUserMedia",
    "webcam-canvas"
  ]
}
